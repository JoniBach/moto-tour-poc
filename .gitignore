.vercel
.env*

# ---- tours (tours/<id>/): the public parts are committed (tour.config.json, day titles, pins,
# stories); the private inputs never are ----
# raw rides (personal location history)
tours/*/gpx/
# original photos (large, private EXIF); resized copies are built into static/photos/<id>/
tours/*/photos-src/
# privacy zones (where family live)
tours/*/privacy.json

# generated per-tour data (routes, photos, feed): large, private, rebuilt by the pipeline
static/data/tours/
static/photos/
# Spotify listening history and its lookups (scripts/build-music.mjs publishes only the ride's plays)
tours/*/spotify/
