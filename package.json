{
	"name": "gt-retrospective",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"data:sample": "node scripts/make-sample-gpx.mjs",
		"data": "node scripts/build-days.mjs",
		"data:region": "node scripts/build-region.mjs",
		"data:tour": "node scripts/build-tour.mjs && node scripts/build-parks.mjs && node scripts/build-places.mjs",
		"data:parks": "node scripts/build-parks.mjs",
		"deploy": "node scripts/deploy.mjs",
		"audit:privacy": "node scripts/audit-privacy.mjs",
		"test:smoke": "node tests/smoke.mjs",
		"data:photos": "node scripts/build-photos.mjs && node scripts/build-feed.mjs",
		"data:blog": "node scripts/build-blog.mjs && node scripts/build-email-images.mjs && node scripts/build-feed.mjs",
		"data:email": "node scripts/build-email-images.mjs",
		"data:feed": "node scripts/build-feed.mjs",
		"data:music": "node --env-file-if-exists=.env.local scripts/build-music.mjs",
		"data:places": "node scripts/build-places.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@mapbox/vector-tile": "^3.0.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/d3": "^7.4.3",
		"@types/node": "^26.6.3",
		"@types/proj4": "^2.5.6",
		"@types/three": "^0.186.0",
		"axe-core": "^4.13.0",
		"exifr": "^7.1.3",
		"pbf": "^5.1.2",
		"pngjs": "^7.0.0",
		"puppeteer-core": "^25.12.0",
		"sharp": "^0.35.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.0",
		"@tiptap/core": "3.31.4",
		"@tiptap/extensions": "3.31.4",
		"@tiptap/markdown": "3.31.4",
		"@tiptap/pm": "3.31.4",
		"@tiptap/starter-kit": "3.31.4",
		"d3": "^7.9.0",
		"maplibre-gl": "^6.11.2",
		"marked": "^18.0.14",
		"proj4": "^2.22.0",
		"three": "^0.186.1"
	}
}
