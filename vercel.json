{
	"redirects": [
		{
			"source": "/",
			"has": [
				{
					"type": "host",
					"value": "moto-tour-poc.vercel.app"
				}
			],
			"destination": "https://gt-retrospective.vercel.app/the-parks-26/",
			"permanent": true
		},
		{
			"source": "/the-parks-26/:path*",
			"has": [
				{
					"type": "host",
					"value": "moto-tour-poc.vercel.app"
				}
			],
			"destination": "https://gt-retrospective.vercel.app/the-parks-26/:path*",
			"permanent": true
		},
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "moto-tour-poc.vercel.app"
				}
			],
			"destination": "https://gt-retrospective.vercel.app/the-parks-26/:path*",
			"permanent": true
		},
		{
			"source": "/",
			"destination": "/the-parks-26/",
			"permanent": false
		},
		{
			"source": "/day/:path*",
			"destination": "/the-parks-26/day/:path*",
			"permanent": true
		},
		{
			"source": "/blog",
			"destination": "/the-parks-26/blog",
			"permanent": true
		},
		{
			"source": "/blog/:path*",
			"destination": "/the-parks-26/blog/:path*",
			"permanent": true
		},
		{
			"source": "/wysiwyg",
			"destination": "/the-parks-26/wysiwyg",
			"permanent": false
		}
	],
	"rewrites": [
		{
			"source": "/robots.txt",
			"destination": "/the-parks-26/robots.txt"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
				},
				{
					"key": "Content-Security-Policy",
					"value": "frame-ancestors 'self'"
				},
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=31536000; includeSubDomains"
				}
			]
		},
		{
			"source": "/photos/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, stale-while-revalidate=604800"
				}
			]
		},
		{
			"source": "/data/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, stale-while-revalidate=86400"
				}
			]
		}
	]
}
