{
	"headers": [
		{
			"source": "/photos/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }]
		},
		{
			"source": "/data/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
		}
	]
}
